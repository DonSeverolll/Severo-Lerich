{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões comuns (PC e Android): HTTP para os provedores de IA.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*" },
        { "url": "https://*/*" },
        { "url": "http://*" },
        { "url": "http://*/*" },
        { "url": "http://*:*" },
        { "url": "http://*:*/*" }
      ]
    }
  ]
}
