{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Agente no PC: PowerShell para execute_command e taskkill para encerrar processos.",
  "platforms": ["windows", "macOS", "linux"],
  "windows": ["main"],
  "permissions": [
    "shell:allow-kill",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "powershell", "cmd": "powershell.exe", "args": true },
        { "name": "pwsh", "cmd": "pwsh.exe", "args": true }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "taskkill", "cmd": "taskkill.exe", "args": true }]
    }
  ]
}
