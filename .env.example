# ===== Gateway LLM (compatível com OpenAI /v1/chat/completions) =====
# URL base do seu gateway de fallback (sem /chat/completions no final)
LLM_BASE_URL=http://localhost:4000/v1

# Uma ou mais chaves separadas por vírgula. Em erro 429/5xx/timeout a chave entra
# em cooldown e o cliente rotaciona para a próxima; 401/403 desativa a chave.
# Deixe vazio se o gateway não exigir Authorization.
LLM_API_KEYS=sk-chave-1,sk-chave-2,sk-chave-3

# Modelo enviado ao gateway (precisa suportar tool calling)
LLM_MODEL=gpt-4o

# Opcionais
# LLM_TEMPERATURE=0.2
# LLM_STREAM=true
# Timeout de inatividade da conexão/stream (ms)
# LLM_REQUEST_TIMEOUT_MS=120000
# Número mínimo de tentativas por requisição (o real é max(isto, nº de chaves x 2))
# LLM_MAX_RETRIES=6
# Cabeçalhos extras para o gateway, em JSON
# LLM_EXTRA_HEADERS={"X-Gateway-Route":"fallback"}

# ===== Agente =====
# Máximo de ciclos ferramenta→modelo por objetivo
# AGENT_MAX_ITERATIONS=40
# Shell para execute_command: powershell | pwsh | cmd | bash
# AGENT_SHELL=powershell
# Timeout padrão de cada comando (ms)
# COMMAND_TIMEOUT_MS=120000
# Tamanho máximo da saída de ferramenta enviada ao modelo (caracteres)
# TOOL_OUTPUT_MAX_CHARS=30000
# Executar ações sem pedir confirmação (equivale a --auto-approve)
# AGENT_AUTO_APPROVE=false
